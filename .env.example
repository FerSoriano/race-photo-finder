# Copy to .env and adjust. .env is gitignored -- never commit real credentials.

ENVIRONMENT=dev
API_BASE_URL=http://localhost:8000

# Guards every /v1/admin route and the `rpf upload` CLI. Change it for production.
ADMIN_API_KEY=dev-insecure-key

DATABASE_URL=postgresql+psycopg://rpf:rpf@localhost:5433/rpf

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" writes to backend/var/storage and serves it from /media.
# "s3" talks to any S3-compatible provider. Switching between them is a config
# change only -- no code knows which one is active.
STORAGE_BACKEND=local

# Two buckets, on purpose. R2 grants public access per bucket -- attaching a
# custom domain exposes everything in it -- so originals live in a private
# bucket reachable only through a signed URL we issue. That separation is what
# makes paid downloads enforceable later.
#   S3_BUCKET        -> originals   (private, never public)
#   S3_PUBLIC_BUCKET -> thumbs+previews (public, behind the CDN domain)

# --- Option A: MinIO (docker compose) -- exercises the S3 path locally ------
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=race-photos-private
# S3_PUBLIC_BUCKET=race-photos-public
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BASE_URL=http://localhost:9000/race-photos-public

# --- Option B: Cloudflare R2 (production) ----------------------------------
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto                       # R2 requires the literal "auto"
# S3_BUCKET=race-photos-private        # keep this bucket's public access OFF
# S3_PUBLIC_BUCKET=race-photos-public  # attach the custom domain to this one
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
# S3_PUBLIC_BASE_URL=https://photos.yourdomain.com   # R2 custom domain (CDN)

# Lifetime of signed URLs for private originals.
PRESIGN_EXPIRES_SECONDS=3600

# Most photos one bulk-download request may ask to be signed at once.
MAX_BULK_DOWNLOAD=10

# ---------------------------------------------------------------------------
# Image derivatives
# ---------------------------------------------------------------------------
THUMB_MAX_PX=400
PREVIEW_MAX_PX=1600
WATERMARK_TEXT=race-photo-finder

# ---------------------------------------------------------------------------
# Detection (local Ollama)
# ---------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_HOST=http://localhost:11434
